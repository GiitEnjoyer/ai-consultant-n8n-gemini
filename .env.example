# Скопируйте файл: cp .env.example .env — и заполните значения.

# --- Обязательные -----------------------------------------------------------
# Ключ Gemini API (бесплатно): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Пароль БД и ключ шифрования учётных данных n8n (любая длинная случайная строка).
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-to-random-32-chars

# --- Уведомления менеджеру в Telegram (рекомендуется) --------------------------
# Токен бота от @BotFather и ID чата менеджера (узнать: написать боту @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# --- Запись заявок в Google Sheets (необязательно) ------------------------------
# ID таблицы из её URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# JSON-ключ сервисного аккаунта положите в secrets/google-service-account.json
# и выдайте сервисному аккаунту доступ «Редактор» к таблице.
GOOGLE_SHEET_ID=

# --- Дополнительно ------------------------------------------------------------
# Токен для POST /reload сервиса базы знаний (пусто — перезагрузка отключена).
KB_ADMIN_TOKEN=
# Порог релевантности BM25: ниже — «в базе знаний нет ответа».
KB_MIN_SCORE=1.5
# Порт демо-сайта с виджетом.
SITE_PORT=8080
# Публичный адрес n8n (для продакшена за HTTPS-прокси).
N8N_PUBLIC_URL=http://localhost:5678/
# true — повторно импортировать workflow из репозитория (перезапишет правки в UI).
FORCE_WORKFLOW_IMPORT=false
