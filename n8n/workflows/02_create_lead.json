    {
      "parameters": {
        "jsCode": "// Итог для агента. Заявка считается принятой, если сохранена хотя бы в одном канале.\nconst lead = $('Нормализация заявки').first().json;\nconst savedToSheet = !$('Запись в Google Sheets').first().json.error;\nconst managerNotified = !$input.first().json.error;\n\nif (!savedToSheet && !managerNotified) {\n  return [{ json: {\n    status: 'error',\n    message: 'Техническая ошибка: заявка не сохранена. Предложите посетителю позвонить по телефону +7 (800) 000-00-00.',\n  } }];\n}\nreturn [{ json: {\n  status: 'ok',\n  leadId: lead.leadId,\n  savedToSheet,\n  managerNotified,\n  message: 'Заявка создана, менеджер свяжется с посетителем в рабочее время.',\n} }];"
      },
