    {
      "parameters": {
        "jsCode": "// Нормализация заявки: телефон в формат +7XXXXXXXXXX, очистка имени, номер заявки.\nconst lead = $input.first().json;\nconst digits = String(lead.phone ?? '').replace(/\\D/g, '');\nlet phone = null;\nif (digits.length === 11 && ['7', '8'].includes(digits[0])) phone = '+7' + digits.slice(1);\nelse if (digits.length === 10 && digits[0] === '9') phone = '+7' + digits;\n\nconst name = String(lead.name ?? '').replace(/\\s+/g, ' ').trim().slice(0, 80);\nconst request = String(lead.request ?? '').replace(/\\s+/g, ' ').trim().slice(0, 1000);\n\nconst errors = [];\nif (!phone) errors.push('Телефон должен быть российским номером из 10–11 цифр');\nif (name.length < 2) errors.push('Не указано имя');\n\nconst now = DateTime.now().setZone('Europe/Moscow');\n// Номер заявки = дата + ID запуска n8n: уникален и позволяет найти запуск в истории.\nconst leadId = 'L-' + now.toFormat('yyMMdd') + '-' + $execution.id;\n\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst telegramText = [\n  '🆕 <b>Новая заявка с сайта</b> ' + leadId,\n  '👤 ' + esc(name),\n  '📞 ' + esc(phone ?? ''),\n  '📝 ' + esc(request || '—'),\n  '🕒 ' + now.toFormat('dd.MM.yyyy HH:mm') + ' (МСК)',\n].join('\\n');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    leadId,\n    createdAt: now.toFormat('yyyy-MM-dd HH:mm:ss'),\n    name,\n    phone,\n    request,\n    sessionId: String(lead.sessionId ?? ''),\n    source: String(lead.source || 'site-chat'),\n    telegramText,\n  },\n}];"
      },
      "id": "0e024d35-256e-565a-996a-8cdd2d01832b",
