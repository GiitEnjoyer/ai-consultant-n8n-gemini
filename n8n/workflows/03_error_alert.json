        "jsCode": "// Формирует уведомление об ошибке в любом рабочем процессе проекта.\nconst { execution = {}, workflow = {} } = $input.first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst text = [\n  '🚨 <b>Ошибка в n8n</b>',\n  'Процесс: ' + esc(workflow.name),\n  'Узел: ' + esc(execution.lastNodeExecuted ?? '—'),\n  'Ошибка: ' + esc(execution.error?.message ?? 'неизвестно').slice(0, 500),\n  execution.url ? 'Запуск: ' + esc(execution.url) : '',\n].filter(Boolean).join('\\n');\nreturn [{ json: { text } }];"
      },
